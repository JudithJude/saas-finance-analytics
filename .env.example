# Copy to .env. `astro dev start` passes these to the Airflow containers.
# Never commit .env: it is in .gitignore.

# Warehouse, as seen from inside the Airflow containers
WAREHOUSE_HOST=warehouse
WAREHOUSE_PORT=5432
WAREHOUSE_DB=warehouse
WAREHOUSE_USER=postgres
WAREHOUSE_PASSWORD=postgres

# dbt target used by Airflow: dev writes to dev_* schemas, prod to staging/intermediate/marts
DBT_TARGET=prod

# true = read the fake files in data/fake_api; false = call the real APIs
USE_FAKE_API=true
STRIPE_API_KEY=

# Optional: post failed-task alerts to Slack
SLACK_WEBHOOK_URL=
